{
  "id": "/",
  "name": "SEEN Studio — Men & Women Spatial Virtual T-Shirt Store",
  "short_name": "SEEN Studio",
  "description": "Luxury dark-mode Men & Women virtual try-on T-shirt e-commerce store with 24 studio tees, headless mannequins, instant bKash checkout, and live D1 catalog.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
